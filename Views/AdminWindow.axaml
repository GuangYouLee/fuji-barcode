<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:fuji_barcode.ViewModels"
        xmlns:m="clr-namespace:fuji_barcode.Models"
        mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="480"
        x:Class="fuji_barcode.Views.AdminWindow"
        x:DataType="vm:AdminWindowViewModel"
        Title="Barcode Mapping Admin"
        Width="720" Height="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,*">
    <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
               Text="Barcode Recipe Mapping Administration"
               FontSize="18"
               FontWeight="SemiBold" />

    <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,4" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
      <TextBlock VerticalAlignment="Center" Text="Unysis Script Override:" FontWeight="SemiBold" />
      <TextBox Grid.Column="1"
               Text="{Binding GlobalScriptInput}"
               Watermark="Optional override for the recipe-matched Unysis script" />
      <Button Grid.Column="2"
              Content="Save Unysis Script"
              Click="ConfirmGlobalScriptSaveClick"
              MinWidth="140" />
      <Button Grid.Column="3"
              Content="{Binding MappingSearchButtonText}"
              Command="{Binding ToggleMappingSearchCommand}"
              MinWidth="120" />
    </Grid>

    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" ColumnDefinitions="*,*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
      <TextBox Grid.Column="0"
               Text="{Binding LogIdInput}"
               Watermark="Log ID(s), one per line"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               MinHeight="56" />
      <TextBox Grid.Column="1"
               Text="{Binding RecipeNameInput}"
               Watermark="Recipe name" />
      <Button Grid.Column="2"
              Content="Save"
              Click="ConfirmSaveClick"
              IsDefault="True"
              MinWidth="90" />
      <Button Grid.Column="3"
              Content="Delete"
              Click="ConfirmDeleteClick"
              MinWidth="90" />
      <Button Grid.Column="4"
              Content="New"
              Command="{Binding ClearCommand}"
              MinWidth="90" />
      <Button Grid.Column="5"
              Content="Refresh"
              Command="{Binding LoadCommand}"
              MinWidth="90" />
    </Grid>

    <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
               Margin="0,12,0,0"
               Text="{Binding StatusText}"
               TextWrapping="Wrap" />

    <Border Grid.Row="4" Grid.ColumnSpan="2"
            Margin="0,12,0,0"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid ColumnDefinitions="2*,2*,*" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Text="Log ID(s)" FontWeight="Bold" />
          <TextBlock Grid.Column="1" Text="Recipe" FontWeight="Bold" />
          <TextBlock Grid.Column="2" Text="Updated" FontWeight="Bold" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
              IsVisible="{Binding IsMappingSearchVisible}">
          <TextBlock VerticalAlignment="Center" Text="Find:" />
          <TextBox Grid.Column="1"
                   Text="{Binding MappingFilterText}"
                   Watermark="Search Log ID or recipe" />
          <Button Grid.Column="2" Content="Clear" Command="{Binding ClearMappingFilterCommand}" MinWidth="70" />
        </Grid>

        <Grid Grid.Row="2">
          <ListBox ItemsSource="{Binding Mappings}"
                   SelectedItem="{Binding SelectedMapping}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="m:BarcodeRecipeMapping">
                <Grid ColumnDefinitions="2*,2*,*" Margin="0,4">
                  <TextBlock Grid.Column="0" Text="{Binding LogId}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="1" Text="{Binding RecipeName}" />
                  <TextBlock Grid.Column="2" Text="{Binding UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock IsVisible="{Binding HasNoMatchingMappings}"
                     Text="No matching mappings."
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
