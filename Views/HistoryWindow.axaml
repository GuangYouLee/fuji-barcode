<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:fuji_barcode.ViewModels" xmlns:m="clr-namespace:fuji_barcode.Models"
        x:Class="fuji_barcode.Views.HistoryWindow" x:DataType="vm:HistoryWindowViewModel"
        Title="Scan history" Width="1000" Height="650" WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <TextBlock Text="Scan history · read only" FontSize="24" FontWeight="SemiBold"/>
    <WrapPanel Grid.Row="1" Orientation="Horizontal">
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,24,8">
      <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanInteract}" MinHeight="52"/>
      <Button Content="Previous" Command="{Binding PreviousCommand}" IsEnabled="{Binding CanPrevious}" MinHeight="52"/>
      <TextBlock Text="{Binding PageText}" VerticalAlignment="Center"/>
      <Button Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanNext}" MinHeight="52"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8" IsEnabled="{Binding CanInteract}">
      <Button MinHeight="52" Width="200" Padding="12,8" Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1"
              CornerRadius="8" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Choose history month and year">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding SelectedMonthText}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="⌄" VerticalAlignment="Center" FontSize="18"/>
        </Grid>
        <Button.Flyout>
          <Flyout Placement="Bottom">
            <StackPanel Spacing="12" Margin="4">
              <TextBlock Text="Choose month and year" FontWeight="SemiBold"/>
              <DatePicker SelectedDate="{Binding SelectedMonth}" DayVisible="False" MonthVisible="True" YearVisible="True"
                          MinHeight="52" MinWidth="220" AutomationProperties.Name="Filter history by month and year"/>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <Button Content="Apply" Command="{Binding ApplyMonthCommand}" MinHeight="52"/>
      <Button Content="All months" Command="{Binding AllMonthsCommand}" MinHeight="52"/>
    </StackPanel>
    </WrapPanel>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:ScanHistoryEntry">
            <Border BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8,12">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding ScannedAt}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding OperatorId, StringFormat='Operator: {0}'}"/>
                <TextBlock Text="{Binding ScannedValue, StringFormat='Scanned: {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LogId, StringFormat='Log ID: {0}'}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding RecipeId, StringFormat='Recipe: {0}'}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="{Binding StatusText}" TextWrapping="Wrap"/>
  </Grid>
</Window>
